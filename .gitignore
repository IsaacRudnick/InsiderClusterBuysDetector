# Contains SEC_USER_AGENT with a real contact email. See .env.example.
# Ignore every .env variant (.env.local, .env.prod) except the checked-in
# template, so a machine-specific copy can never be committed by accident.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Caches. Expensive to rebuild but reproducible, and far too large for git.
# ---------------------------------------------------------------------------
# ~1.3M JSON files, one per SEC accession (~2 GB). Rebuilt by scraping, at
# roughly a day per year of history -- back it up, but do not commit it.
parse_cache/
# Per-ticker price parquets (~420 MB), refetched from Yahoo on demand.
price_cache/
ipo_cache/
# One JSON per issuer CIK (SIC code, exchange), refilled by tools/issuer_meta.py.
issuer_meta_cache/

# SEC submissions filings, one JSON per issuer CIK (~43 MB). Rebuilt by
# `python tools/filing_calendar.py` in about 15 minutes; not worth versioning.
filing_cache/

# ---------------------------------------------------------------------------
# Generated outputs
# ---------------------------------------------------------------------------
# One directory per backtest run: report.html plus equity_*/trades_*.csv for
# every strategy x exit pair. Hundreds of MB per full grid run.
out/
# Scraped event parquets (~100 MB) -- regenerate with backtest.py, or keep
# your own backup. Committing them would bloat history permanently.
clusters_history/
# Research datasets, OOF scores, fitted model bundles, stability summaries.
# All reproducible via run_research.py.
research_data/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
*.bak
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
# Per-machine permission grants. CLAUDE.md itself is committed.
.claude/settings.local.json

# Caches for the 2026-08-21 data sources. All reproducible by re-running
# the tool that built them; none worth versioning.
# SEC submissions JSON per dead-ticker CIK, for tools/delisting_fate.py
delist_cache/
# raw FINRA short-interest responses, per settlement date
short_interest_cache/
# SEC bulk financial-statement ZIPs, ~3.4 GB
xbrl_cache/
# per-issuer 13D/13G and 8-K item data
filing_context_cache/
# FRED macro series CSVs
fred_cache/
