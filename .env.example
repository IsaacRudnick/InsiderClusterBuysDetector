# Copy to .env and fill in your own details.
#
# REQUIRED by SEC fair-access rules: a descriptive User-Agent identifying
# you and a real contact email. Without this, SEC may throttle or block you.
# The scraper sends this on every request and rate-limits itself to 8 req/s
# (SEC's published ceiling is 10).
SEC_USER_AGENT=Your Name your.email@example.com

# ---------------------------------------------------------------------------
# Live screener (insider_cluster_buys.py). All optional.
# ---------------------------------------------------------------------------
# Set these three to skip the interactive prompts. Required for a scheduled or
# piped run, where a bare input() with no stdin blocks forever.
#ICB_LOOKBACK=30
#ICB_MIN_INSIDERS=2
#ICB_WINDOW_DAYS=14

# 0 skips the price fetch for scored tickers. Faster, fewer features resolved.
#LIVE_SCORE_FETCH_PRICES=1

# Pin the model bundle and the research dataset used for score percentiles,
# instead of resolving the newest of each from research_data/. Build them with
# `python run_research.py --fit-production` and `--build-dataset`.
#LIVE_SCORE_MODEL_PATH=research_data/production_model_YYYYMMDD.joblib
#LIVE_SCORE_HISTORY_PATH=research_data/research_NNNNNrows_YYYYMMDD.parquet
